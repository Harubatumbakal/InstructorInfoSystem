@model InstructorInformationSystemm.Models.Instructor

@{
    ViewData["Title"] = "Delete Instructor";
}

<div class="container mt-5" style="max-width: 700px;">
    <div class="card shadow-sm">
        <div class="card-body p-4">
            <h2>Delete Instructor</h2>

            <div class="alert alert-warning mt-3">
                Are you sure you want to delete this instructor?
            </div>

            <dl class="row">
                <dt class="col-sm-4">Full Name</dt>
                <dd class="col-sm-8">@Model.FullName</dd>

                <dt class="col-sm-4">Age</dt>
                <dd class="col-sm-8">@Model.Age</dd>

                <dt class="col-sm-4">Address</dt>
                <dd class="col-sm-8">@Model.Address</dd>

                <dt class="col-sm-4">Designation</dt>
                <dd class="col-sm-8">@Model.Designation</dd>

                <dt class="col-sm-4">Gender</dt>
                <dd class="col-sm-8">@Model.Gender</dd>

                <dt class="col-sm-4">Major</dt>
                <dd class="col-sm-8">@Model.Major</dd>

                <dt class="col-sm-4">Bachelor Degree</dt>
                <dd class="col-sm-8">@Model.BachelorDegree</dd>

                <dt class="col-sm-4">Email Address</dt>
                <dd class="col-sm-8">@Model.EmailAddress</dd>

                <dt class="col-sm-4">Contact Number</dt>
                <dd class="col-sm-8">@Model.ContactNumber</dd>
            </dl>

            <form asp-controller="Instructor"
                  asp-action="Delete"
                  asp-route-id="@Model.Id"
                  method="post">

                <button type="submit" class="btn btn-danger">
                    Confirm Delete
                </button>

                <a asp-action="Index" class="btn btn-secondary">
                    Cancel
                </a>
            </form>
        </div>
    </div>
</div>
